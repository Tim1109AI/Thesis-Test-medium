     return H_.scale_to_power(Wb, p)
 
 
+def init_core_mask(H, d, p):
+    """init_core for a BS-specific association (d.bsmask): the private stream of each core user is the regularized ZF
+    direction over the antennas of the BSs that carry it only (the other served core private streams' channels on
+    those antennas, the same regularization as init_core), instead of the direction over all BN antennas with the
+    blocks of the other BSs zeroed. Equal to init_core when every BS carries every stream. (Option, off by default.)"""
+    if getattr(d, 'bsmask', None) is None:
+        return init_core(H, d, p)
+    N, B = p['N'], p['B']
+    W = init_core(H, d, p)
+    pw = np.sum(np.abs(W) ** 2, axis=0)
+    base = [k for k in d.core if (1 + d.G + k) in d.col]
+    if not base:
+        return W
+    alpha = len(base) / (B * p['Pmax'])
+    for i, k in enumerate(base):
+        c = d.col[1 + d.G + k]
+        ant = np.concatenate([np.arange(b * N, (b + 1) * N) for b in range(B) if d.bsmask[b, c]])
+        Hp = H[base][:, ant]
+        v = np.linalg.solve(Hp.conj().T @ Hp + alpha * np.eye(len(ant)), Hp.conj().T)[:, i]
+        W[:, c] = 0.0; W[ant, c] = v / np.linalg.norm(v) * math.sqrt(pw[c])
+    return H_.scale_to_power(W, p)
+
+
 INITS['core'] = init_core
+INITS['core_mask'] = init_core_mask
 INITS['core_mf'] = lambda H, d, p: init_core(H, d, p, mf=True)
 INITS['bn'] = init_bn
 INITS['zf'] = init_zf
